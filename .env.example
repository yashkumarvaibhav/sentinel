# Sentinel — environment template.
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
# Every secret below is optional: Sentinel runs fully, and passes every score
# gate, with none of them set.

# --- Runtime ----------------------------------------------------------------
SENTINEL_ENV=dev
SENTINEL_LOG_LEVEL=info
SENTINEL_CONFIG_DIR=./config

# --- Host ports (8040–8049 block only — see docs/ports.md) ------------------
SENTINEL_GATEWAY_PORT=8040
SENTINEL_WEB_PORT=8041

# --- Datastores (compose-internal hostnames) --------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_SCHEMA=sentinel
POSTGRES_DEV_SCHEMA=sentinel_dev

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=sentinel
CLICKHOUSE_USER=sentinel
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_RETENTION_DAYS=15

# Per-process connection budget. Keep this small on the shared VM.
STORAGE_POOL_MIN_SIZE=1
STORAGE_POOL_MAX_SIZE=4
STORAGE_TIMEOUT_SECONDS=10

REDPANDA_BROKERS=redpanda:9092
INGEST_GROUP_ID=sentinel-ingest-v1
INGEST_DEDUP_CAPACITY=100000
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org
CONTEXT_HTTP_TIMEOUT_SECONDS=5
VICTORIAMETRICS_URL=http://victoriametrics:8428
LOKI_URL=http://loki:3100
TEMPO_URL=http://tempo:3200

# --- Reasoner (optional; cloud free tier only) ------------------------------
# Provider chain: Groq → Gemini → deterministic rules.
# With no keys set the deterministic rules path is used. Never log these.
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Interim access gate (until OIDC lands) ---------------------------------
# Shared secret required on mutating and sensitive routes once exposed.
SENTINEL_SHARED_SECRET=
# One server-bound identity for that credential. The browser cannot override it.
SENTINEL_INTERIM_OPERATOR_ID=interim-operator

# --- Durable action runtime --------------------------------------------------
# Compose enables this by default. Set false only for a deliberately API-only
# gateway; config/action.yml remains the reviewed dry-run/live authority.
SENTINEL_ACTION_WORKER_ENABLED=true
SENTINEL_ACTION_WORKER_ID=gateway-action-worker
SENTINEL_ACTION_POLL_INTERVAL_SECONDS=1
SENTINEL_ACTION_POLL_BATCH_LIMIT=8
SENTINEL_ACTION_SETTLEMENT_DELAY_SECONDS=15
SENTINEL_ACTION_SLO_WINDOW_SECONDS=300
