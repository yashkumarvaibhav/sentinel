    "AuditEventKind": {
      "description": "What kind of thing the ledger is recording.\n\nDeliberately small. The ledger records what the platform *decided* and what\nit *did about it*, which is the pair a person needs to reconstruct an\nincident; telemetry lives in the stores that are built for it.",
      "enum": [
        "DECISION",
        "ACTION_PLANNED",
        "ACTION_APPLIED",
        "ACTION_VERIFIED",
        "ACTION_REVERTED",
        "ACTION_REFUSED",
        "ROLLBACK",
        "BREAKER_OPENED",
        "APPROVAL"
      ],
      "title": "AuditEventKind",
      "type": "string"
    },
