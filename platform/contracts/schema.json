{
  "$defs": {
    "AgentAssessment": {
      "additionalProperties": false,
      "description": "One agent's evidence-backed verdict about one axis at one event time.\n\nA calm axis (``SCORED`` at ``0.0`` with no evidence) is a genuine finding:\nthe claimed detectors ran and saw nothing. An axis whose detectors produced\nno coverage is ``INSUFFICIENT`` instead, so absence of evidence is never\nsilently reported as evidence of absence.",
      "properties": {
        "assessment_id": {
          "$ref": "#/$defs/Identifier"
        },
        "axis": {
          "$ref": "#/$defs/EvidenceAxis"
        },
        "covered_kinds": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SymptomKind"
          },
          "title": "Covered Kinds",
          "type": "array"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "title": "Evidence",
          "type": "array"
        },
        "note": {
          "$ref": "#/$defs/HumanText"
        },
        "score": {
          "$ref": "#/$defs/Probability"
        },
        "services": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Services",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/AgentStatus"
        },
        "trend": {
          "$ref": "#/$defs/AgentTrend"
        },
        "ts": {
          "$ref": "#/$defs/UtcDatetime"
        }
      },
      "required": [
        "assessment_id",
        "axis",
        "ts",
        "status",
        "score",
        "trend",
        "note"
      ],
      "title": "AgentAssessment",
      "type": "object"
    },
    "AgentStatus": {
      "description": "Whether an agent had the coverage to score its axis at all.",
      "enum": [
        "SCORED",
        "INSUFFICIENT"
      ],
      "title": "AgentStatus",
      "type": "string"
    },
    "AgentTrend": {
      "description": "Direction of an axis score against the agent's previous assessment.",
      "enum": [
        "RISING",
        "FALLING",
        "STEADY",
        "UNKNOWN"
      ],
      "title": "AgentTrend",
      "type": "string"
    },
    "ChangeEvent": {
      "additionalProperties": false,
      "description": "One recorded operator change, the raw material of deploy-correlated pressure.\n\nA change is a fact about the system's own history, never a conclusion about\nan incident. It carries its own honesty label because the MVP feed mixes an\noperator-maintained ledger with changes observed from the cluster.",
      "properties": {
        "change_id": {
          "$ref": "#/$defs/Identifier"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "honesty": {
          "enum": [
            "REAL",
            "SIMULATED"
          ],
          "title": "Honesty",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ChangeKind"
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "service": {
          "$ref": "#/$defs/Identifier"
        },
        "source": {
          "$ref": "#/$defs/Identifier"
        },
        "summary": {
          "$ref": "#/$defs/HumanText"
        },
        "ts": {
          "$ref": "#/$defs/UtcDatetime"
        }
      },
      "required": [
        "change_id",
        "kind",
        "service",
        "ts",
        "summary",
        "source",
        "honesty"
      ],
      "title": "ChangeEvent",
      "type": "object"
    },
    "ChangeKind": {
      "description": "How the system was changed by its operators, not by its callers.",
      "enum": [
        "DEPLOY",
        "ROLLOUT",
        "FLAG",
        "CONFIG"
      ],
      "title": "ChangeKind",
      "type": "string"
    },
    "ContextWindow": {
      "additionalProperties": false,
      "description": "A trusted external event and the signals whose volume it may explain.",
      "properties": {
        "context_id": {
          "$ref": "#/$defs/Identifier"
        },
        "event_type": {
          "$ref": "#/$defs/Identifier"
        },
        "expected_delta": {
          "additionalProperties": {
            "$ref": "#/$defs/FiniteFloat"
          },
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/SignalName"
          },
          "title": "Expected Delta",
          "type": "object"
        },
        "honesty": {
          "enum": [
            "REAL",
            "SIMULATED"
          ],
          "title": "Honesty",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/HumanText"
        },
        "source": {
          "$ref": "#/$defs/Identifier"
        },
        "trust_score": {
          "$ref": "#/$defs/Probability"
        },
        "valid_from": {
          "$ref": "#/$defs/UtcDatetime"
        },
        "valid_to": {
          "$ref": "#/$defs/UtcDatetime"
        }
      },
      "required": [
        "context_id",
        "name",
        "event_type",
        "source",
        "honesty",
        "valid_from",
        "valid_to",
        "expected_delta",
        "trust_score"
      ],
      "title": "ContextWindow",
      "type": "object"
    },
    "DecompFrame": {
      "additionalProperties": false,
      "description": "Full-resolution split of observed telemetry into explained and residual parts.",
      "properties": {
        "band_high": {
          "$ref": "#/$defs/FiniteFloat"
        },
        "band_low": {
          "$ref": "#/$defs/FiniteFloat"
        },
        "context_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Context Ids",
          "type": "array"
        },
        "explained_base": {
          "$ref": "#/$defs/FiniteFloat"
        },
        "explained_event": {
          "$ref": "#/$defs/FiniteFloat"
        },
        "frame_id": {
          "$ref": "#/$defs/Identifier"
        },
        "observation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "observed": {
          "$ref": "#/$defs/FiniteFloat"
        },
        "residual": {
          "$ref": "#/$defs/FiniteFloat"
        },
        "residual_score": {
          "$ref": "#/$defs/Probability"
        },
        "service": {
          "$ref": "#/$defs/Identifier"
        },
        "signal": {
          "$ref": "#/$defs/SignalName"
        },
        "ts": {
          "$ref": "#/$defs/UtcDatetime"
        }
      },
      "required": [
        "frame_id",
        "observation_id",
        "ts",
        "service",
        "signal",
        "observed",
        "explained_base",
        "explained_event",
        "residual",
        "band_low",
        "band_high",
        "residual_score"
      ],
      "title": "DecompFrame",
      "type": "object"
    },
    "EpisodeStatus": {
      "description": "Lifecycle state of an anti-flapping symptom episode.",
      "enum": [
        "ACTIVE",
        "CLOSED"
      ],
      "title": "EpisodeStatus",
      "type": "string"
    },
    "EvidenceAxis": {
      "description": "The independent axes a surge is judged on, one agent per axis.\n\nEach axis is scored from its own claimed evidence only. An attacker who\nkeeps one axis calm cannot thereby quiet another, because no agent ever\nreads another agent's score.",
      "enum": [
        "SECURITY",
        "RELIABILITY",
        "CHANGE_CONFIG",
        "BUSINESS_IMPACT"
      ],
      "title": "EvidenceAxis",
      "type": "string"
    },
    "EvidenceDirection": {
      "description": "Which way a measured value sits relative to its stated baseline.",
      "enum": [
        "ABOVE_BASELINE",
        "BELOW_BASELINE",
        "AT_BASELINE"
      ],
      "title": "EvidenceDirection",
      "type": "string"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "description": "One measured value that justifies part of an axis score.\n\nAn agent never reports a bare number: every point of score is traceable to\nan item naming the feature, what was measured, what it is compared with,\nwhich way it moved and how much of the score it contributed.",
      "properties": {
        "baseline": {
          "$ref": "#/$defs/FiniteFloat"
        },
        "contribution": {
          "$ref": "#/$defs/Probability"
        },
        "direction": {
          "$ref": "#/$defs/EvidenceDirection"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "feature": {
          "$ref": "#/$defs/SignalName"
        },
        "note": {
          "$ref": "#/$defs/HumanText"
        },
        "value": {
          "$ref": "#/$defs/FiniteFloat"
        }
      },
      "required": [
        "feature",
        "value",
        "baseline",
        "direction",
        "contribution",
        "note"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "FiniteFloat": {
      "type": "number"
    },
    "HumanText": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "Identifier": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "Observation": {
      "additionalProperties": false,
      "description": "One event-time telemetry value, containing evidence but never answer-key data.",
      "properties": {
        "attributes": {
          "additionalProperties": {
            "$ref": "#/$defs/TelemetryScalar"
          },
          "propertyNames": {
            "$ref": "#/$defs/SignalName"
          },
          "title": "Attributes",
          "type": "object"
        },
        "flow_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Flow Refs",
          "type": "array"
        },
        "log_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Log Refs",
          "type": "array"
        },
        "observation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "service": {
          "$ref": "#/$defs/Identifier"
        },
        "signal": {
          "$ref": "#/$defs/SignalName"
        },
        "trace_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Trace Refs",
          "type": "array"
        },
        "ts": {
          "$ref": "#/$defs/UtcDatetime"
        },
        "unit": {
          "$ref": "#/$defs/UnitName",
          "default": "1"
        },
        "value": {
          "$ref": "#/$defs/FiniteFloat"
        }
      },
      "required": [
        "observation_id",
        "ts",
        "service",
        "signal",
        "value"
      ],
      "title": "Observation",
      "type": "object"
    },
    "Probability": {
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    },
    "SignalName": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "Symptom": {
      "additionalProperties": false,
      "description": "One scored, human-legible piece of evidence about abnormal behavior.",
      "properties": {
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/SymptomKind"
        },
        "note": {
          "$ref": "#/$defs/HumanText"
        },
        "onset_ts": {
          "$ref": "#/$defs/UtcDatetime"
        },
        "score": {
          "$ref": "#/$defs/Probability"
        },
        "service": {
          "$ref": "#/$defs/Identifier"
        },
        "signal": {
          "$ref": "#/$defs/SignalName"
        },
        "symptom_id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "symptom_id",
        "kind",
        "service",
        "signal",
        "onset_ts",
        "score",
        "note"
      ],
      "title": "Symptom",
      "type": "object"
    },
    "SymptomEpisode": {
      "additionalProperties": false,
      "description": "A hysteresis-guarded lifecycle over repeated symptoms of one key.\n\nAn episode groups the recurring symptoms of a single ``(kind, service,\nsignal)`` into one durable incident-precursor. It opens only after a symptom\npersists (breach persistence + a score deadband) and closes only after it\nclears for long enough, so a momentary blip can never open one and a key can\nnever flap. Raw ``Symptom`` evidence is untouched; an episode only points at\nit via the opening, peak and latest symptom ids.",
      "properties": {
        "breach_tick_count": {
          "minimum": 1,
          "title": "Breach Tick Count",
          "type": "integer"
        },
        "closed_ts": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcDatetime"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confirmed_ts": {
          "$ref": "#/$defs/UtcDatetime"
        },
        "episode_id": {
          "$ref": "#/$defs/Identifier"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/SymptomKind"
        },
        "last_breach_ts": {
          "$ref": "#/$defs/UtcDatetime"
        },
        "latest_symptom_id": {
          "$ref": "#/$defs/Identifier"
        },
        "opened_ts": {
          "$ref": "#/$defs/UtcDatetime"
        },
        "opening_symptom_id": {
          "$ref": "#/$defs/Identifier"
        },
        "peak_score": {
          "$ref": "#/$defs/Probability"
        },
        "peak_symptom_id": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "service": {
          "$ref": "#/$defs/Identifier"
        },
        "signal": {
          "$ref": "#/$defs/SignalName"
        },
        "status": {
          "$ref": "#/$defs/EpisodeStatus"
        }
      },
      "required": [
        "episode_id",
        "kind",
        "service",
        "signal",
        "status",
        "opened_ts",
        "confirmed_ts",
        "last_breach_ts",
        "peak_score",
        "breach_tick_count",
        "revision",
        "opening_symptom_id",
        "peak_symptom_id",
        "latest_symptom_id"
      ],
      "title": "SymptomEpisode",
      "type": "object"
    },
    "SymptomKind": {
      "description": "Deterministic evidence categories understood by the decision plane.",
      "enum": [
        "RESIDUAL_EXCEED",
        "RATIO_DEFORM",
        "LOG_BURST",
        "EDGE_DEGRADED",
        "SATURATION",
        "DEPLOY_MARKER",
        "DROP",
        "SILENCE"
      ],
      "title": "SymptomKind",
      "type": "string"
    },
    "TelemetryScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        }
      ]
    },
    "UnitName": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "UtcDatetime": {
      "format": "date-time",
      "type": "string"
    }
  },
  "$id": "urn:sentinel:contracts:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Public contracts exchanged between Sentinel planes.",
  "oneOf": [
    {
      "$ref": "#/$defs/Observation"
    },
    {
      "$ref": "#/$defs/ContextWindow"
    },
    {
      "$ref": "#/$defs/DecompFrame"
    },
    {
      "$ref": "#/$defs/Symptom"
    },
    {
      "$ref": "#/$defs/SymptomEpisode"
    },
    {
      "$ref": "#/$defs/ChangeEvent"
    },
    {
      "$ref": "#/$defs/AgentAssessment"
    }
  ],
  "title": "SentinelContract"
}
