    },
    {
      "$ref": "#/$defs/Symptom"
    },
    {
      "$ref": "#/$defs/SymptomEpisode"
    },
    {
      "$ref": "#/$defs/ChangeEvent"
    },
    {
      "$ref": "#/$defs/AgentAssessment"
    },
    {
      "$ref": "#/$defs/Verdict"
    },
    {
      "$ref": "#/$defs/Incident"
    },
    {
      "$ref": "#/$defs/Verification"
    },
    {
      "$ref": "#/$defs/Decision"
    },
    {
      "$ref": "#/$defs/ActionPlan"
    },
    {
      "$ref": "#/$defs/ActionOutcome"
    },
    {
