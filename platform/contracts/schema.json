    "EpisodeStatus": {
      "description": "Lifecycle state of an anti-flapping symptom episode.",
      "enum": [
        "ACTIVE",
        "CLOSED"
      ],
      "title": "EpisodeStatus",
      "type": "string"
    },
    "EvidenceAxis": {
      "description": "The independent axes a surge is judged on, one agent per axis.\n\nEach axis is scored from its own claimed evidence only. An attacker who\nkeeps one axis calm cannot thereby quiet another, because no agent ever\nreads another agent's score.",
      "enum": [
        "SECURITY",
        "RELIABILITY",
        "CHANGE_CONFIG",
        "BUSINESS_IMPACT"
      ],
      "title": "EvidenceAxis",
      "type": "string"
    },
    "EvidenceDirection": {
      "description": "Which way a measured value sits relative to its stated baseline.",
      "enum": [
        "ABOVE_BASELINE",
        "BELOW_BASELINE",
        "AT_BASELINE"
      ],
      "title": "EvidenceDirection",
      "type": "string"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "description": "One measured value that justifies part of an axis score.\n\nAn agent never reports a bare number: every point of score is traceable to\nan item naming the feature, what was measured, what it is compared with,\nwhich way it moved and how much of the score it contributed.",
      "properties": {
        "baseline": {
          "$ref": "#/$defs/FiniteFloat"
        },
        "contribution": {
          "$ref": "#/$defs/Probability"
        },
        "direction": {
          "$ref": "#/$defs/EvidenceDirection"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "feature": {
          "$ref": "#/$defs/SignalName"
        },
        "note": {
          "$ref": "#/$defs/HumanText"
        },
        "value": {
          "$ref": "#/$defs/FiniteFloat"
        }
      },
      "required": [
        "feature",
        "value",
        "baseline",
        "direction",
        "contribution",
        "note"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "FiniteFloat": {
      "type": "number"
    },
    "HumanText": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "Identifier": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "Incident": {
      "additionalProperties": false,
      "description": "One real-world problem, assembled from the storm of symptoms it caused.\n\nA single fault lights many detectors across many services. An incident is\nthe collapse of that storm into the one thing an on-call person is actually\ndealing with: co-occurring episodes on services that are near each other in\nthe topology become one incident, not twelve alerts.\n\nIdentity is anchored to the earliest episode in the cluster, so the incident\nkeeps its id as the storm grows around it.\n\n``services`` are the services that carried a symptom. ``implicated_services``\nare the ones named only by the evidence - a service whose caller's degraded\ndependency edge accuses it while it emits nothing of its own. The two are\nkept apart because they are different claims: one was observed misbehaving,\nthe other was merely blamed, and a real cascade's origin is routinely the\nsecond kind.",
      "properties": {
        "anchor_episode_id": {
          "$ref": "#/$defs/Identifier"
        },
        "business_impact": {
          "anyOf": [
            {
              "$ref": "#/$defs/Probability"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "episode_ids": {
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "title": "Episode Ids",
          "type": "array"
        },
        "implicated_services": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Implicated Services",
          "type": "array"
        },
        "incident_id": {
          "$ref": "#/$defs/Identifier"
        },
        "kinds": {
          "items": {
            "$ref": "#/$defs/SymptomKind"
          },
          "minItems": 1,
          "title": "Kinds",
          "type": "array"
        },
        "last_activity_ts": {
          "$ref": "#/$defs/UtcDatetime"
        },
        "merged_incident_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Merged Incident Ids",
          "type": "array"
        },
        "note": {
          "$ref": "#/$defs/HumanText"
        },
        "opened_ts": {
          "$ref": "#/$defs/UtcDatetime"
        },
        "origin_confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Probability"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin_service": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "services": {
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "title": "Services",
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/IncidentSeverity"
        },
        "state": {
          "$ref": "#/$defs/IncidentState"
        }
      },
      "required": [
        "incident_id",
        "anchor_episode_id",
        "opened_ts",
        "last_activity_ts",
        "state",
        "severity",
        "services",
        "kinds",
        "episode_ids",
        "revision",
        "note"
      ],
      "title": "Incident",
      "type": "object"
    },
    "IncidentSeverity": {
      "description": "How much this incident matters, in the language a responder pages on.",
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "title": "IncidentSeverity",
      "type": "string"
    },
    "IncidentState": {
      "description": "Where an incident is in its life, from first symptom to resolved.",
      "enum": [
        "OPEN",
        "MITIGATING",
        "MONITORING",
        "RESOLVED"
      ],
      "title": "IncidentState",
      "type": "string"
    },
    "Observation": {
      "additionalProperties": false,
      "description": "One event-time telemetry value, containing evidence but never answer-key data.",
      "properties": {
        "attributes": {
          "additionalProperties": {
            "$ref": "#/$defs/TelemetryScalar"
          },
          "propertyNames": {
            "$ref": "#/$defs/SignalName"
          },
          "title": "Attributes",
          "type": "object"
        },
        "flow_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Flow Refs",
          "type": "array"
        },
        "log_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Log Refs",
          "type": "array"
        },
        "observation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "service": {
          "$ref": "#/$defs/Identifier"
        },
        "signal": {
          "$ref": "#/$defs/SignalName"
        },
        "trace_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Trace Refs",
          "type": "array"
        },
        "ts": {
          "$ref": "#/$defs/UtcDatetime"
        },
        "unit": {
          "$ref": "#/$defs/UnitName",
          "default": "1"
        },
        "value": {
          "$ref": "#/$defs/FiniteFloat"
        }
      },
      "required": [
        "observation_id",
        "ts",
        "service",
        "signal",
        "value"
      ],
      "title": "Observation",
      "type": "object"
    },
    "Probability": {
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    },
    "ReasonSubtype": {
      "description": "A refinement that changes what a sane response looks like.\n\n``CAPACITY_SHORTAGE`` exists so under-provisioning is answered with\n\"scale\", never with \"block\": the traffic is real and the system is simply\ntoo small for it.",
      "enum": [
        "CAPACITY_SHORTAGE"
      ],
      "title": "ReasonSubtype",
      "type": "string"
    },
    "RejectedAlternative": {
      "additionalProperties": false,
      "description": "One diagnosis that was considered and the evidence that ruled it out.",
      "properties": {
        "reason": {
          "$ref": "#/$defs/HumanText"
        },
        "verdict_class": {
          "$ref": "#/$defs/VerdictClass"
        }
      },
      "required": [
        "verdict_class",
        "reason"
      ],
      "title": "RejectedAlternative",
      "type": "object"
    },
    "SignalName": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "SuppressionKind": {
      "description": "Why an operator asked the platform to hold back.\n\n``CHANGE_FREEZE`` forbids autonomous action without quieting anything: the\nproblem is still reported, we simply do not touch production during the\nfreeze. ``MAINTENANCE`` is the stronger claim that expected disruption on\nnamed services is not worth reporting.",
      "enum": [
        "CHANGE_FREEZE",
        "MAINTENANCE"
      ],
      "title": "SuppressionKind",
      "type": "string"
    },
    "Symptom": {
      "additionalProperties": false,
      "description": "One scored, human-legible piece of evidence about abnormal behavior.",
      "properties": {
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/SymptomKind"
        },
        "note": {
          "$ref": "#/$defs/HumanText"
        },
        "onset_ts": {
          "$ref": "#/$defs/UtcDatetime"
        },
        "score": {
          "$ref": "#/$defs/Probability"
        },
        "service": {
          "$ref": "#/$defs/Identifier"
        },
        "signal": {
          "$ref": "#/$defs/SignalName"
        },
        "symptom_id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "symptom_id",
        "kind",
        "service",
        "signal",
        "onset_ts",
        "score",
        "note"
      ],
      "title": "Symptom",
      "type": "object"
    },
    "SymptomEpisode": {
      "additionalProperties": false,
      "description": "A hysteresis-guarded lifecycle over repeated symptoms of one key.\n\nAn episode groups the recurring symptoms of a single ``(kind, service,\nsignal)`` into one durable incident-precursor. It opens only after a symptom\npersists (breach persistence + a score deadband) and closes only after it\nclears for long enough, so a momentary blip can never open one and a key can\nnever flap. Raw ``Symptom`` evidence is untouched; an episode only points at\nit via the opening, peak and latest symptom ids.",
      "properties": {
        "breach_tick_count": {
          "minimum": 1,
          "title": "Breach Tick Count",
          "type": "integer"
        },
        "closed_ts": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcDatetime"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confirmed_ts": {
          "$ref": "#/$defs/UtcDatetime"
        },
        "episode_id": {
          "$ref": "#/$defs/Identifier"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/SymptomKind"
        },
        "last_breach_ts": {
          "$ref": "#/$defs/UtcDatetime"
        },
        "latest_symptom_id": {
          "$ref": "#/$defs/Identifier"
        },
        "opened_ts": {
          "$ref": "#/$defs/UtcDatetime"
        },
        "opening_symptom_id": {
          "$ref": "#/$defs/Identifier"
        },
        "peak_score": {
          "$ref": "#/$defs/Probability"
        },
        "peak_symptom_id": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "service": {
          "$ref": "#/$defs/Identifier"
        },
        "signal": {
          "$ref": "#/$defs/SignalName"
        },
        "status": {
          "$ref": "#/$defs/EpisodeStatus"
        }
      },
      "required": [
        "episode_id",
        "kind",
        "service",
        "signal",
        "status",
        "opened_ts",
        "confirmed_ts",
        "last_breach_ts",
        "peak_score",
        "breach_tick_count",
        "revision",
        "opening_symptom_id",
        "peak_symptom_id",
        "latest_symptom_id"
      ],
      "title": "SymptomEpisode",
      "type": "object"
    },
    "SymptomKind": {
      "description": "Deterministic evidence categories understood by the decision plane.",
      "enum": [
        "RESIDUAL_EXCEED",
        "RATIO_DEFORM",
        "LOG_BURST",
        "EDGE_DEGRADED",
        "SATURATION",
        "DEPLOY_MARKER",
        "DROP",
        "SILENCE"
      ],
      "title": "SymptomKind",
      "type": "string"
    },
    "TelemetryScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        }
      ]
    },
    "UnitName": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "UtcDatetime": {
      "format": "date-time",
      "type": "string"
    },
    "Verdict": {
      "additionalProperties": false,
      "description": "The fused, evidence-backed answer, with its differential diagnosis.\n\n``verdict_class`` comes from the ordered rule table - crisp, operator-owned\nand explainable. ``distribution`` is the same signatures read softly, so the\nrunner-up is visible rather than hidden. Every class that lost is recorded\nin ``rejected_alternatives`` with the requirement it failed, so the answer\ncan be argued with rather than merely believed.",
      "properties": {
        "assessment_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Assessment Ids",
          "type": "array"
        },
        "confidence": {
          "$ref": "#/$defs/Probability"
        },
        "corroborating_kinds": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SymptomKind"
          },
          "title": "Corroborating Kinds",
          "type": "array"
        },
        "distribution": {
          "additionalProperties": {
            "$ref": "#/$defs/Probability"
          },
          "minProperties": 1,
          "title": "Distribution",
          "type": "object"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "title": "Evidence",
          "type": "array"
        },
        "reason": {
          "$ref": "#/$defs/HumanText"
        },
        "reason_subtype": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasonSubtype"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rejected_alternatives": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RejectedAlternative"
          },
          "title": "Rejected Alternatives",
          "type": "array"
        },
        "rule_id": {
          "$ref": "#/$defs/Identifier"
        },
        "services": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Services",
          "type": "array"
        },
        "ts": {
          "$ref": "#/$defs/UtcDatetime"
        },
        "verdict_class": {
          "$ref": "#/$defs/VerdictClass"
        },
        "verdict_id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "verdict_id",
        "ts",
        "verdict_class",
        "rule_id",
        "confidence",
        "reason",
        "distribution"
      ],
      "title": "Verdict",
      "type": "object"
    },
    "VerdictClass": {
      "description": "What the fused evidence says is actually happening.",
      "enum": [
        "EXPECTED_EVENT",
        "ATTACK",
        "OPERATIONAL_FAULT",
        "CODE_CONFIG_FAULT",
        "COMBINATION"
      ],
      "title": "VerdictClass",
      "type": "string"
    },
    "Verification": {
      "additionalProperties": false,
      "description": "The four deterministic checks a hypothesis must survive before it is acted on.\n\nNothing here proposes anything. Each check is arithmetic over telemetry and\ncommitted topology, and all four must hold: a hypothesis that is merely\nplausible is left unconfirmed, which downstream means pending review rather\nthan action.\n\n``BOOTSTRAP`` is a vacuous pass, recorded as such and never as a\nconfirmation. It exists only so that an empty incident memory cannot make\nconfirmation impossible forever.",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/VerificationCheck"
          },
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "confirmed": {
          "title": "Confirmed",
          "type": "boolean"
        },
        "incident_id": {
          "$ref": "#/$defs/Identifier"
        },
        "ts": {
          "$ref": "#/$defs/UtcDatetime"
        },
        "verification_id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "verification_id",
        "ts",
        "incident_id",
        "confirmed",
        "checks"
      ],
      "title": "Verification",
      "type": "object"
    },
    "VerificationCheck": {
      "additionalProperties": false,
      "description": "One non-LLM check and the evidence-derived reason for its answer.",
      "properties": {
        "detail": {
          "$ref": "#/$defs/HumanText"
        },
        "name": {
          "$ref": "#/$defs/Identifier"
        },
        "outcome": {
          "$ref": "#/$defs/CheckOutcome"
        }
      },
      "required": [
        "name",
        "outcome",
        "detail"
      ],
      "title": "VerificationCheck",
      "type": "object"
    }
  },
  "$id": "urn:sentinel:contracts:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Public contracts exchanged between Sentinel planes.",
  "oneOf": [
    {
      "$ref": "#/$defs/Observation"
    },
    {
